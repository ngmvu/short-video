# Gemini
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
IDEA_STYLE="Hài hước, bất ngờ, nhịp nhanh, có câu móc mở đầu trong 1 giây, tình huống leo thang và cú bẻ lái dễ nhớ. Luân phiên nhiều nội dung hài hước đời thường Việt Nam nhưng luôn giữ cố định 2 nhân vật gốc là Khỉ (@khi, giọng @Voice_Khi) và Người (@nguoi, giọng @Voice_Nguoi); tránh lặp mô-típ, thoại tự nhiên kiểu Việt Nam, gag hình ảnh rõ, phù hợp mọi lứa tuổi."
CHARACTER_1_TAG=@khi
CHARACTER_1_VOICE=@Voice_Khi
CHARACTER_2_TAG=@nguoi
CHARACTER_2_VOICE=@Voice_Nguoi

# Telegram bot and private chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Google Flow UI (selectors are CSS selectors and must match the current UI)
FLOW_PROJECT_URL=
FLOW_AUTH_FILE=auth.json
FLOW_AGENT_TOGGLE_SELECTOR=button[aria-pressed]:has-text("Agent")
FLOW_SETTINGS_SELECTOR=button[aria-label="Settings trigger"]:visible
FLOW_VIDEO_MODE_SELECTOR=button[role="radio"]:has-text("Video")
FLOW_ASPECT_RATIO_SELECTOR=button[role="radio"]:has-text("9:16")
FLOW_DURATION_SELECTOR=button[role="radio"]:has-text("10s")
FLOW_OUTPUT_COUNT_SELECTOR=button[role="radio"]:has-text("x1")
FLOW_PROMPT_SELECTOR=[contenteditable="true"][aria-label="What do you want to create?"]
FLOW_SUBMIT_SELECTOR=button[aria-label="Start generation"]
FLOW_RESULT_SELECTOR=flow-grid-tile-container[role="group"]:has(flow-video-tile)
FLOW_DOWNLOAD_MENU_SELECTOR=button[aria-label="More options"]
FLOW_DOWNLOAD_SELECTOR=[role="menuitem"]:has-text("720p Original size")
FLOW_RENDER_TIMEOUT_MS=900000
FLOW_DOWNLOAD_TIMEOUT_MS=900000

# YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=yt_token.json

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Facebook Graph API / Reels
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

LOG_LEVEL=INFO
